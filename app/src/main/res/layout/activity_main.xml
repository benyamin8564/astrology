<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="Astro Research Analyzer" android:textSize="27sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="نمودار تولد + آسترولوژی غربی/ودیک + نامورولوژی + جداول" android:textSize="15sp" android:layout_marginBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="نام و نام خانوادگی"><com.google.android.material.textfield.TextInputEditText android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="تاریخ تولد — 1990-01-25 یا 19900125"><com.google.android.material.textfield.TextInputEditText android:id="@+id/date" android:inputType="number" android:layout_width="match_parent" android:layout_height="wrap_content"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ساعت تولد — 14:30 یا 1430"><com.google.android.material.textfield.TextInputEditText android:id="@+id/time" android:inputType="number" android:layout_width="match_parent" android:layout_height="wrap_content"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="شهر تولد"><com.google.android.material.textfield.TextInputEditText android:id="@+id/city" android:layout_width="match_parent" android:layout_height="wrap_content"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="کشور تولد"><com.google.android.material.textfield.TextInputEditText android:id="@+id/country" android:layout_width="match_parent" android:layout_height="wrap_content"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="منطقه زمانی مثل +03:30"><com.google.android.material.textfield.TextInputEditText android:id="@+id/tz" android:inputType="numberSigned|numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="عرض جغرافیایی"><com.google.android.material.textfield.TextInputEditText android:id="@+id/lat" android:inputType="numberSigned|numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="طول جغرافیایی"><com.google.android.material.textfield.TextInputEditText android:id="@+id/lon" android:inputType="numberSigned|numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/></com.google.android.material.textfield.TextInputLayout>
<TextView android:text="سیستم زودیاک" android:textStyle="bold" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Spinner android:id="@+id/zodiacSystem" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="سیستم خانه" android:textStyle="bold" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Spinner android:id="@+id/houseSystem" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="تحمل ریسک مالی 1 تا 10 (اختیاری)"><com.google.android.material.textfield.TextInputEditText android:id="@+id/risk" android:inputType="number" android:layout_width="match_parent" android:layout_height="wrap_content"/></com.google.android.material.textfield.TextInputLayout>
<Button android:id="@+id/analyze" android:text="ساخت نمودار و تحلیل کامل" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
<com.astroresearch.app.BirthChartView android:id="@+id/chartView" android:layout_width="match_parent" android:layout_height="390dp" android:layout_marginTop="8dp"/>
<TextView android:id="@+id/result" android:textIsSelectable="true" android:textSize="15sp" android:fontFamily="monospace" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="یادآوری: خروجی‌های آسترولوژی و نامورولوژی تفسیری/سنتی هستند و جایگزین تشخیص پزشکی یا مشاوره مالی نیستند." android:textSize="13sp" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
</ScrollView>
